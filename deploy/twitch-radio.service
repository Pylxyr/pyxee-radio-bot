[Unit]
Description=Twitch Radio Bot
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/twitch-radio-bot
Environment="PATH=/home/ubuntu/twitch-radio-bot/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
Environment="PYTHONMALLOC=malloc"
# ProtectHome=read-only below blocks Deno's default cache dir (normally
# under $HOME/.cache/deno) — redirected under data/, the one place this
# unit can actually write, so it doesn't need to fall back to re-fetching/
# recompiling on every run. Harmless if Node/Bun/QuickJS is used instead.
Environment="DENO_DIR=/home/ubuntu/twitch-radio-bot/data/deno-cache"
EnvironmentFile=/home/ubuntu/twitch-radio-bot/.env
ExecStart=/home/ubuntu/twitch-radio-bot/.venv/bin/python /home/ubuntu/twitch-radio-bot/bot.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
OOMScoreAdjust=-100
LimitNOFILE=65536

# Hardening. Deliberately does NOT include MemoryDenyWriteExecute=yes, and
# does NOT set SystemCallFilter — both for the same underlying reason: this
# service needs a working V8-based JS runtime (Deno by default — see
# deploy/setup.sh; Node is also supported, see YTDLP_JS_RUNTIME_NAME in
# .env.example) for yt-dlp to fully support YouTube, and JIT compilation is
# fundamentally incompatible with the kind of restriction both directives
# apply:
#   - MemoryDenyWriteExecute=yes: tested directly (native Linux MDWE, the
#     same enforcement mechanism this directive uses) — Deno panics on
#     ENOMEM on the very first script it runs under it, not just under
#     heavy load. Trivial one-liners crash it immediately.
#   - SystemCallFilter=@system-service: confirmed directly under this exact
#     unit — Deno's JS-challenge solver died with returncode -31 (SIGSYS)
#     specifically under this directive, producing symptoms that look
#     unrelated at first (yt-dlp falling back to image-only formats,
#     "Requested format is not available"), since the actual failure (a
#     killed subprocess) happens several layers below the error yt-dlp
#     surfaces. The exact same extraction worked outside systemd entirely,
#     and under a partial systemd-run sandbox *without* this directive —
#     isolating it as the cause. @system-service is a broad allowlist, not
#     a minimal one, but it still doesn't cover whatever syscalls a V8
#     JIT needs (mmap/mprotect sequences for RWX transitions being the
#     likely candidates, though this wasn't narrowed further).
# Enabling either would break song requests outright, not as a narrow edge
# case, so both are deliberately left out. Every other hardening directive
# below stays in place.
ProtectSystem=full
PrivateTmp=yes
NoNewPrivileges=yes
ProtectHome=read-only
# Only data/ and logs/ are writable — the OAuth token file and tunables.json
# both live under data/ (see twitch_radio/config.py's DATA_DIR) specifically
# so this one entry covers everything the process needs to persist.
ReadWritePaths=/home/ubuntu/twitch-radio-bot/data /home/ubuntu/twitch-radio-bot/logs
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
