# ─────────────────────────────────────────────────────────────
# Twitch Radio — standalone service. Every setting below is required; there's
# no "disabled" mode, unlike when this lived inside the Discord bot as an
# optional feature. Getting the bot account authenticated is a manual,
# one-time step even after these are filled in — see the module docstring in
# twitch_radio/chatbot.py, or the README, for the full walkthrough.
# ─────────────────────────────────────────────────────────────

# From https://dev.twitch.tv/console/apps — register an application there
# (OAuth Redirect URL: http://localhost:4343/oauth/callback), Client ID and
# a generated Client Secret both come from that app's page.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Numeric Twitch user IDs, not usernames. BOT_ID is the account the bot
# chats as (recommend a dedicated account, made a moderator in your
# channel); OWNER_ID is the broadcaster/channel the bot joins.
TWITCH_BOT_ID=
TWITCH_OWNER_ID=

# From Twitch's Stream Key page (Creator Dashboard > Settings > Stream) —
# treat this like a password.
TWITCH_STREAM_KEY=
TWITCH_INGEST_URL=rtmp://live.twitch.tv/app

# Command prefix in Twitch chat
TWITCH_PREFIX=!

# Static background image for the video track ffmpeg loops while streaming.
# A default is included at deploy/background.png — swap it for your own art.
TWITCH_BACKGROUND_IMAGE=deploy/background.png
TWITCH_VIDEO_BITRATE_KBPS=800
TWITCH_VIDEO_FPS=2

# Local-only HTTP surface: /nowplaying.json for OBS overlays, /settings for
# the request-limit tunables page. Leave TWITCH_NOWPLAYING_HOST at 127.0.0.1
# unless you understand the exposure — nothing in front of this validates
# who's allowed to reach it besides TWITCH_SETTINGS_PASSWORD (Basic Auth,
# /settings only — /nowplaying.json is always public, it's meant to be
# fetched by an OBS browser source).
TWITCH_NOWPLAYING_HOST=127.0.0.1
TWITCH_NOWPLAYING_PORT=8098
TWITCH_SETTINGS_PASSWORD=

# Filenames under data/ (gitignored, and the only directory the systemd
# unit's ReadWritePaths allows writes to) — no reason to change these
# unless you're running more than one instance out of one data/ directory.
# TWITCH_TOKEN_FILE=twitch_tokens.json
# TWITCH_TUNABLES_FILE=tunables.json

# ─────────────────────────────────────────────────────────────
# yt-dlp
# ─────────────────────────────────────────────────────────────

# Path to a cookies.txt file (Netscape format) if you need to resolve
# age-restricted or otherwise gated content.
# YTDLP_COOKIES_FILE=cookies.txt

# yt-dlp needs an external JavaScript runtime to fully support YouTube (Deno,
# Node, Bun, or QuickJS — see https://github.com/yt-dlp/yt-dlp/wiki/EJS).
# Leave unset and yt-dlp auto-detects a `deno` binary on PATH — deploy/setup.sh
# installs Deno system-wide for exactly this. Only set this to pin a
# specific binary instead.
# YTDLP_JS_RUNTIME_PATH=
#
# Which runtime YTDLP_JS_RUNTIME_PATH points to. Only matters if that's set.
# Defaults to "deno" since that's what setup.sh installs; change this if
# you're pinning a Node/Bun/QuickJS binary instead.
# YTDLP_JS_RUNTIME_NAME=deno

# How many concurrent yt-dlp extractions this service runs at once. There's
# no sibling feature to protect from contention anymore (that's the whole
# point of this being a separate service) — 2 is a reasonable default for a
# single-viewer-facing radio; raise it if !sr gets busy.
# YTDLP_CONCURRENCY=2
# YTDLP_EXTRACT_TIMEOUT_SECONDS=45

# ─────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
# LOG_TO_FILE=true
